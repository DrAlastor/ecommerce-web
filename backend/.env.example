# Environment variables for the backend
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials

# Microsoft Azure Database for PostgreSQL Flexible Server
# Formato: postgresql://<usuario>:<password>@<servidor>.postgres.database.azure.com:5432/<nombre_bd>?sslmode=require
DATABASE_URL="postgresql://<admin_user>:<password>@<server-name>.postgres.database.azure.com:5432/<db_name>?sslmode=require"

# Optional AI recommendations service
# If omitted, CU26 uses the local recommendation fallback with real catalog data.
AI_RECOMMENDATIONS_URL=""
AI_RECOMMENDATIONS_API_KEY=""
AI_RECOMMENDATIONS_TIMEOUT_MS="6000"
