# Environment variables for the backend
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials

# Prisma / PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@your-host.postgres.database.azure.com:5432/ecommerce?schema=public&sslmode=require"

# Optional AI recommendations service
# If omitted, CU26 uses the local recommendation fallback with real catalog data.
AI_RECOMMENDATIONS_URL=""
AI_RECOMMENDATIONS_API_KEY=""
AI_RECOMMENDATIONS_TIMEOUT_MS="6000"
