# Environment variables for the backend
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials

# Supabase / PostgreSQL connection strings
# Pooler (Port 6543 - for runtime/production):
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (Port 5432 - for migrations):
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# Optional AI recommendations service
# If omitted, CU26 uses the local recommendation fallback with real catalog data.
AI_RECOMMENDATIONS_URL=""
AI_RECOMMENDATIONS_API_KEY=""
AI_RECOMMENDATIONS_TIMEOUT_MS="6000"
